// Pro tutorial overlays v4 — Screen Studio / Arcade grade (visual-first)
// Hole spotlight · gold focus ring · big cursor · multi-ripple · STEP caption
// v4: cursor ALWAYS tracks primary (no metrics park) · soft zoom · faster hold snap
(() => {
  if (window.__helenaDirectorOverlayV4) return;
  window.__helenaDirectorOverlayV4 = true;
  window.__helenaDirectorOverlayV3 = true;
  window.__helenaDirectorOverlayV2 = true; // compat flag for enforce

  const css = `
  #hd-progress {
    position: fixed; left: 0; top: 0; height: 4px; z-index: 2147483647;
    background: linear-gradient(90deg,#3db8a8,#d4a84b,#f0c75e);
    width: 0%; transition: width .45s ease;
    box-shadow: 0 0 12px rgba(61,184,168,.55);
  }
  #hd-chip {
    position: fixed; top: 14px; left: 50%; transform: translateX(-50%);
    z-index: 2147483647;
    font-family: "Noto Sans CJK KR",system-ui,sans-serif;
    font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase;
    color: #0a0908; background: linear-gradient(90deg,#3db8a8,#5fd4c4);
    padding: 9px 16px; border-radius: 999px; white-space: nowrap;
    box-shadow: 0 6px 24px rgba(0,0,0,.45);
  }
  #hd-hole {
    position: fixed; z-index: 2147483645; pointer-events: none;
    border-radius: 14px;
    box-shadow: 0 0 0 9999px rgba(0,0,0,.36);
    outline: 3px solid rgba(61,184,168,.95);
    outline-offset: 4px;
    transition: left .4s cubic-bezier(.16,1,.3,1), top .4s cubic-bezier(.16,1,.3,1),
      width .4s cubic-bezier(.16,1,.3,1), height .4s cubic-bezier(.16,1,.3,1), opacity .28s;
    opacity: 0;
  }
  #hd-ring {
    position: fixed; z-index: 2147483646; pointer-events: none;
    border: 3px solid #f0c75e; border-radius: 16px;
    box-shadow:
      0 0 0 6px rgba(240,199,94,.22),
      0 0 0 12px rgba(61,184,168,.12),
      0 0 36px rgba(240,199,94,.45);
    transition: left .38s cubic-bezier(.16,1,.3,1), top .38s cubic-bezier(.16,1,.3,1),
      width .38s cubic-bezier(.16,1,.3,1), height .38s cubic-bezier(.16,1,.3,1), opacity .22s;
    opacity: 0;
  }
  #hd-ring.live {
    animation: hdRingPulse 1.4s ease-in-out infinite;
  }
  @keyframes hdRingPulse {
    0%, 100% { box-shadow: 0 0 0 6px rgba(240,199,94,.22), 0 0 0 12px rgba(61,184,168,.12), 0 0 28px rgba(240,199,94,.4); }
    50% { box-shadow: 0 0 0 10px rgba(240,199,94,.32), 0 0 0 18px rgba(61,184,168,.18), 0 0 48px rgba(240,199,94,.55); }
  }
  #hd-cursor {
    position: fixed; z-index: 2147483647; pointer-events: none;
    width: 48px; height: 48px; margin-left: -6px; margin-top: -4px;
    left: 50%; top: 42%;
    transition: left .58s cubic-bezier(.16,1,.3,1), top .58s cubic-bezier(.16,1,.3,1), transform .15s;
    filter: drop-shadow(0 3px 10px rgba(0,0,0,.6));
    opacity: 1;
  }
  #hd-cursor.fast {
    transition: left .18s cubic-bezier(.16,1,.3,1), top .18s cubic-bezier(.16,1,.3,1), transform .12s;
  }
  #hd-cursor svg { display: block; width: 48px; height: 48px; }
  #hd-cursor.pulse { transform: scale(.78); }
  /* Real auto-zoom (community A: recast/Screen Studio language) */
  html.hd-zoom-root {
    overflow: hidden;
  }
  body.hd-zoomed {
    transition: transform .58s cubic-bezier(.16,1,.3,1);
    will-change: transform;
    transform-origin: 50% 40%;
  }
  body.hd-zoomed.hd-zoom-strong {
    /* stronger product-demo punch — still keeps chrome readable */
  }
  #hd-ripple, #hd-ripple2, #hd-ripple3 {
    position: fixed; z-index: 2147483646; pointer-events: none;
    width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%;
    opacity: 0;
  }
  #hd-ripple { border: 3px solid #3db8a8; }
  #hd-ripple2 { border: 3px solid #f0c75e; }
  #hd-ripple3 { border: 2px solid #f4efe6; }
  #hd-ripple.on { animation: hdRipple .7s ease-out forwards; }
  #hd-ripple2.on { animation: hdRipple .85s ease-out .08s forwards; }
  #hd-ripple3.on { animation: hdRipple 1s ease-out .14s forwards; }
  @keyframes hdRipple {
    0% { transform: scale(.35); opacity: .95; }
    100% { transform: scale(3.4); opacity: 0; }
  }
  #hd-caption {
    position: fixed; left: 14px; right: 14px; bottom: 18px; z-index: 2147483647;
    font-family: "Noto Sans CJK KR","Noto Sans CJK",system-ui,sans-serif;
    background: rgba(10,9,8,.92); border: 1px solid rgba(244,239,230,.18);
    border-left: 4px solid #3db8a8; color: #f4efe6;
    font-size: 16px; font-weight: 700; line-height: 1.4;
    padding: 13px 15px; border-radius: 8px;
    backdrop-filter: blur(12px); word-break: keep-all;
    opacity: 0; transition: opacity .25s;
    box-shadow: 0 10px 40px rgba(0,0,0,.4);
  }
  #hd-caption .hd-k {
    display: block; font-size: 11px; letter-spacing: .16em; text-transform: uppercase;
    color: #3db8a8; margin-bottom: 5px; font-weight: 800;
  }
  #hd-callout {
    position: fixed; z-index: 2147483646; pointer-events: none;
    font-family: "Noto Sans CJK KR",system-ui,sans-serif;
    font-size: 13px; font-weight: 800; color: #0a0908;
    background: linear-gradient(90deg,#f0c75e,#e8b84a); padding: 7px 12px; border-radius: 6px;
    opacity: 0; transition: opacity .22s, transform .28s;
    transform: translateY(6px);
    box-shadow: 0 6px 18px rgba(0,0,0,.4);
    letter-spacing: .04em;
  }
  #hd-callout.show { opacity: 1; transform: translateY(0); }
  #hd-click-badge {
    position: fixed; z-index: 2147483647; pointer-events: none;
    font-family: system-ui,sans-serif;
    font-size: 11px; font-weight: 900; letter-spacing: .12em;
    color: #0a0908; background: #3db8a8;
    padding: 5px 10px; border-radius: 999px;
    opacity: 0; transition: opacity .2s, transform .25s;
    transform: scale(.85);
    box-shadow: 0 4px 16px rgba(61,184,168,.5);
  }
  #hd-click-badge.show { opacity: 1; transform: scale(1); }
  `;

  const style = document.createElement("style");
  style.textContent = css;
  document.documentElement.appendChild(style);

  const progress = Object.assign(document.createElement("div"), { id: "hd-progress" });
  const chip = Object.assign(document.createElement("div"), { id: "hd-chip", textContent: "PRODUCT TOUR" });
  const caption = Object.assign(document.createElement("div"), { id: "hd-caption" });
  caption.innerHTML = '<span class="hd-k">STEP</span><span class="hd-t"></span>';
  const hole = Object.assign(document.createElement("div"), { id: "hd-hole" });
  const ring = Object.assign(document.createElement("div"), { id: "hd-ring" });
  const ripple = Object.assign(document.createElement("div"), { id: "hd-ripple" });
  const ripple2 = Object.assign(document.createElement("div"), { id: "hd-ripple2" });
  const ripple3 = Object.assign(document.createElement("div"), { id: "hd-ripple3" });
  const callout = Object.assign(document.createElement("div"), { id: "hd-callout" });
  const badge = Object.assign(document.createElement("div"), { id: "hd-click-badge", textContent: "CLICK" });
  const cursor = Object.assign(document.createElement("div"), { id: "hd-cursor" });
  cursor.innerHTML = `<svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M8 4l22 17.2-9.8 2.2L26 38.5l-4.4 1.9-4.2-14.4L8 33.5V4z"
      fill="#f4efe6" stroke="#0a0908" stroke-width="2"/>
    <path d="M8 4l22 17.2-9.8 2.2L26 38.5l-4.4 1.9-4.2-14.4L8 33.5V4z"
      stroke="#f0c75e" stroke-width="1.2" fill="none" opacity=".9"/>
  </svg>`;

  [progress, chip, caption, hole, ring, ripple, ripple2, ripple3, callout, badge, cursor].forEach((el) =>
    document.documentElement.appendChild(el)
  );

  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  let cursorPos = { x: window.innerWidth * 0.5, y: window.innerHeight * 0.55 };

  function placeBox(el, target, pad = 10) {
    if (!target) {
      el.style.opacity = "0";
      return null;
    }
    const r = target.getBoundingClientRect();
    const left = Math.max(4, r.left - pad);
    const top = Math.max(52, r.top - pad); // below chip
    let width = Math.min(window.innerWidth - left - 4, Math.max(48, r.width + pad * 2));
    let height = Math.min(window.innerHeight - top - 90, Math.max(40, r.height + pad * 2));
    // hard cap — never swallow the whole viewport
    width = Math.min(width, window.innerWidth - 24);
    height = Math.min(height, Math.min(420, window.innerHeight * 0.55));
    el.style.left = left + "px";
    el.style.top = top + "px";
    el.style.width = width + "px";
    el.style.height = height + "px";
    el.style.opacity = "1";
    return { left, top, width, height, cx: left + width / 2, cy: top + height / 2 };
  }

  window.__hd = {
    version: 4,
    _primary: null,
    setCaption(text, kicker = "STEP") {
      caption.querySelector(".hd-k").textContent = kicker;
      caption.querySelector(".hd-t").textContent = text || "";
      caption.style.opacity = text ? "1" : "0";
    },
    setChip(text) {
      chip.textContent = text || "PRODUCT TOUR";
    },
    setProgress(p) {
      progress.style.width = Math.max(0, Math.min(100, p * 100)) + "%";
    },
    /** Resolve a tight, clickable primary — NEVER stats/metrics grids */
    _resolveTarget(el) {
      if (!el) return null;
      const r0 = el.getBoundingClientRect();
      const maxRing = Math.min(window.innerHeight * 0.48, 380);
      let target = el;
      // Prefer concrete interactive / heading inside large sections
      if (r0.height > maxRing || r0.width > window.innerWidth * 0.92) {
        target =
          el.querySelector(
            "a.btn.btn-solid, a.btn, .acc-head, button.wc-item, " +
            "h1, h2, .ch-title, button, [role='button'], g.node"
          ) || el;
      }
      // Hard ban: metric tiles / counters (anti-pattern: cursor on FILES etc.)
      const ban = (node) => {
        if (!node || !node.closest) return false;
        return !!(
          node.closest(".stat, .stats, .metric, .metrics, .stat-grid, .kpi, .counters") ||
          node.closest("[data-stat], [class*='stat-'], [class*='metric']")
        );
      };
      if (ban(target)) {
        target =
          document.querySelector("#cover a.btn.btn-solid, a.btn.btn-solid, h1") ||
          target;
      }
      return target;
    },
    _placeCallout(el, label) {
      if (!label || !el) return;
      const r = el.getBoundingClientRect();
      callout.textContent = label;
      let cy = r.top - 44;
      let cx = Math.min(window.innerWidth - 180, Math.max(10, r.left));
      if (r.height > window.innerHeight * 0.45 || r.top < 56) {
        cy = Math.max(56, Math.min(r.top + 10, window.innerHeight - 80));
        cx = Math.min(window.innerWidth - 180, Math.max(12, r.left + 8));
      } else {
        cy = Math.max(56, cy);
      }
      cy = Math.max(52, Math.min(window.innerHeight - 52, cy));
      cx = Math.max(8, Math.min(window.innerWidth - 160, cx));
      callout.style.left = cx + "px";
      callout.style.top = cy + "px";
      callout.classList.add("show");
    },
    /**
     * Auto-zoom to primary (recast/Screen Studio language).
     * scale 1.0 → 1.14 with ease; origin = target center.
     * Logs last zoom for actions_log via window.__hdZoomLog.
     */
    autoZoom(el, on, strength = 1.14) {
      try {
        window.__hdZoomLog = window.__hdZoomLog || [];
        if (!on) {
          document.documentElement.classList.remove("hd-zoom-root");
          document.body.classList.remove("hd-zoomed", "hd-zoom-strong");
          document.body.style.transform = "";
          document.body.style.transformOrigin = "";
          window.__hdZoomLog.push({ t: Date.now(), on: false });
          return null;
        }
        if (!el) return null;
        const r = el.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const ox = (cx / window.innerWidth) * 100;
        const oy = Math.min(72, Math.max(28, (cy / window.innerHeight) * 100));
        // Cap strength for huge elements (don't over-zoom full sections)
        let s = strength;
        if (r.height > window.innerHeight * 0.45) s = Math.min(s, 1.08);
        if (r.height > window.innerHeight * 0.65) s = Math.min(s, 1.05);
        document.documentElement.classList.add("hd-zoom-root");
        document.body.classList.add("hd-zoomed", "hd-zoom-strong");
        document.body.style.transformOrigin = ox + "% " + oy + "%";
        document.body.style.transform = "scale(" + s + ")";
        const entry = {
          t: Date.now(),
          on: true,
          scale: s,
          ox, oy,
          cx: Math.round(cx),
          cy: Math.round(cy),
          w: Math.round(r.width),
          h: Math.round(r.height),
        };
        window.__hdZoomLog.push(entry);
        return entry;
      } catch (e) {
        return null;
      }
    },
    /** @deprecated alias */
    _softZoom(el, on) {
      return this.autoZoom(el, on, on ? 1.14 : 1.0);
    },
    async focus(el, label) {
      if (!el) return null;
      const target = this._resolveTarget(el);
      this._primary = target;
      target.scrollIntoView({ block: "center", behavior: "instant" });
      await sleep(220);
      const box = placeBox(hole, target, 12);
      placeBox(ring, target, 8);
      ring.classList.add("live");
      this._placeCallout(target, label);
      // CRITICAL: cursor must ride primary — never leave parked on metrics
      await this.moveCursorTo(target, false);
      this.autoZoom(target, true, 1.14);
      await sleep(300);
      return box;
    },
    /** Keep focus + cursor on element for beat hold — do NOT clear after click */
    holdFocus(el, label) {
      if (!el) return;
      const target = this._resolveTarget(el);
      this._primary = target;
      placeBox(hole, target, 12);
      placeBox(ring, target, 8);
      ring.classList.add("live");
      this._placeCallout(target, label);
      // snap cursor onto primary (fast) — kills metrics parking
      this.moveCursorTo(target, true);
      this.autoZoom(target, true, 1.12);
    },
    clearFocus() {
      hole.style.opacity = "0";
      ring.style.opacity = "0";
      ring.classList.remove("live");
      callout.classList.remove("show");
      badge.classList.remove("show");
      this.autoZoom(null, false);
      this._primary = null;
    },
    drainZoomLog() {
      const log = window.__hdZoomLog || [];
      window.__hdZoomLog = [];
      return log;
    },
    /**
     * @param {Element} el
     * @param {boolean} fast  true = hold/snap (no long glide)
     */
    async moveCursorTo(el, fast = false) {
      if (!el) return cursorPos;
      const r = el.getBoundingClientRect();
      // Prefer interactive center; clamp inside box
      const x = r.left + Math.min(Math.max(r.width * 0.55, 14), Math.max(18, r.width - 12));
      const y = r.top + Math.min(Math.max(r.height * 0.42, 12), Math.max(18, r.height - 12));
      if (fast) cursor.classList.add("fast");
      else cursor.classList.remove("fast");
      cursor.style.left = x + "px";
      cursor.style.top = y + "px";
      cursorPos = { x, y };
      await sleep(fast ? 160 : 560);
      cursor.classList.remove("fast");
      return cursorPos;
    },
    async clickAnim(x, y) {
      for (const el of [ripple, ripple2, ripple3]) {
        el.style.left = x + "px";
        el.style.top = y + "px";
        el.classList.remove("on");
      }
      void ripple.offsetWidth;
      ripple.classList.add("on");
      ripple2.classList.add("on");
      ripple3.classList.add("on");
      badge.style.left = x + 18 + "px";
      badge.style.top = y - 28 + "px";
      badge.classList.add("show");
      cursor.classList.add("pulse");
      await sleep(160);
      cursor.classList.remove("pulse");
      await sleep(380);
      badge.classList.remove("show");
    },
    /**
     * Full pro sequence: spotlight → cursor path → multi-ripple → hold focus.
     * Caller must NOT clearFocus until beat ends.
     */
    async demoClick(el, label) {
      if (!el) return false;
      const target = this._resolveTarget(el);
      await this.focus(target, label || "Click");
      const pos = await this.moveCursorTo(target, false);
      await this.clickAnim(pos.x, pos.y);
      this.holdFocus(target, label || "Click");
      await sleep(280);
      return true;
    },
    /** Safe park — upper-mid, NOT metrics band (~55–70% on cover) */
    parkCursor() {
      const x = window.innerWidth * 0.5;
      const y = window.innerHeight * 0.38;
      cursor.style.left = x + "px";
      cursor.style.top = y + "px";
      cursorPos = { x, y };
    },
  };

  window.__hd.parkCursor();
})();
