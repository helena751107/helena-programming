{
  "id": "tutorial_v1",
  "name": "Big-tech product tutorial (forced)",
  "version": 2,
  "description": "LLM 자유 연출 금지. perfect_ship_v1 사다리 미충족 시 렌더·TG 전송 불가.",
  "mode": "bigtech_tutorial",
  "process_id": "perfect_ship_v1",
  "require": {
    "scout_before_write": true,
    "intro_via_html_playwright": true,
    "forbid_ffmpeg_drawtext_intro": true,
    "min_beats": 4,
    "max_beats": 7,
    "max_narration_chars": 78,
    "max_narration_sec": 11.0,
    "min_narration_sec": 2.5,
    "forbid_phrases": [
      "구조를 그림으로 봅니다",
      "열어 확인합니다",
      "여기까지 소개였습니다"
    ],
    "camera_must_have_selector_except_goto_top": true,
    "clicks_required_when_scout_has_interactive": true,
    "min_successful_clicks": 4,
    "require_all_declared_clicks": true,
    "optional_clicks_forbidden": true,
    "show_cursor_highlight": true,
    "require_cursor_on_primary": true,
    "show_caption_bar": true,
    "show_progress_chip": true,
    "show_spotlight": true,
    "min_overlay_version": 5,
    "expand_all_before_tour": false,
    "collapse_before_tour": true,
    "page_ready_contract": true,
    "lead_black_max_sec": 0.35,
    "first_frame_min_size_bytes": 80000,
    "mid_frame_min_size_bytes": 120000,
    "quality_gate_must_pass": true,
    "actions_log_required": true,
    "require_visual_proof": true,
    "min_visual_proof_pass": 4,
    "min_mid_gold_pixels": 60,
    "min_mid_teal_pixels": 15,
    "vision_qa_required": true,
    "vision_qa_pass_score": 100,
    "require_directing": true,
    "directing_id": "product_tour_v1",
    "require_phases_played": true,
    "min_shoot_version": 5,
    "require_tts_humanize": true,
    "require_tts_first": true,
    "require_auto_zoom": true,
    "require_process": true,
    "process_id": "perfect_ship_v1",
    "default_format": "shorts_1080"
  },
  "ship": {
    "block_without_policy_pass": true,
    "block_without_actions_log": true,
    "block_without_quality_pass": true,
    "block_without_scout_json": true,
    "block_without_visual_proof": true,
    "block_without_vision_qa": true,
    "block_without_directing": true,
    "block_without_phases_played": true,
    "block_without_process_verify": true,
    "block_without_cursor_on_primary": true,
    "block_without_all_declared_clicks": true
  },
  "notes": [
    "만점 프로세스: process/perfect_ship_v1.json + perfect_ship.py",
    "에이전트 진입점: python3 perfect_ship.py (run_director --process perfect_ship_v1)",
    "즉흥 품질 패치 금지 — 게이트 실패 시 remediation_map 키만 수정 후 사다리 재실행",
    "v3 visual_proof · v4 vision QA · v5 5막 · v6 cursor-lock/multi-click/humanize — 전부 process에 고정"
  ]
}
